@TaskFlow.API_HostAddress = http://localhost:5295

GET {{TaskFlow.API_HostAddress}}/weatherforecast/
Accept: application/json

###

POST {{TaskFlow.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@taskflow.com",
  "password": "demo1234"
}

###

@token = paste-the-token-from-the-login-response-here

GET {{TaskFlow.API_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}


# ASP.NET Core secrets / local overrides — never commit real connection strings, JWT signing
# keys, or other secrets. Use `dotnet user-secrets` or environment variables for real values;
# appsettings.Development.json stays tracked since it currently holds only placeholder values.
appsettings.*.local.json
secrets.json

